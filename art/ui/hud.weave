/* Keep gameplay's authored overlay hitboxes. Weave may style appearance,
   but must not relocate buttons or create viewport-sized touch blockers. */
.hud-button {
    background: #17262fe8;
    border-color: #bda47c;
    border-width: 2px;
    border-radius: 10px;
}
.hud-label {
    color: #fff2d7;
    font-size: 15px;
    text-align: center;
    font-weight: 700;
}
#touch-build { background: #36564b; border-color: #e2c899; }
@media (orientation: portrait) {
    .hud-button { border-radius: 9px; }
    .hud-label { font-size: 13px; }
}
@media (max-height: 500px) and (orientation: landscape) {
    .hud-label { font-size: 12px; }
}
