// First Last Signal salvage interaction slice.
// The Keeper's Explorer script decides when E or the PICK UP button reaches
// the alternator and signals it here; recovering hides the part.
script RecoverAlternator {
    var recovered: bool = false;
    fn update(dt: f32) {
        if this.recovered { return; }
        if World.take_signal("pick_up") > 0.0 {
            let explorer = World.find("Explorer");
            if explorer == null { return; }
            this.recovered = true;
            World.set_active(this.entity, false);
            World.send_signal(explorer, "take_alternator", 1.0);
            print("Recovered replacement alternator.");
        }
    }
}
