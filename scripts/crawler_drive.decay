// Keyboard and Sindri's native floating touch stick control the crawler.
// Steering uses 3D yaw and movement follows the crawler's facing direction.
const KNOB_TRAVEL: f32 = 0.11;

script CrawlerDrive {
    @export let speed: f32 = 2.0;
    @export let turn_speed: f32 = 1.6;

    var cargo_button: Entity = null;
    var tank_button: Entity = null;
    var antenna_button: Entity = null;
    var cargo: Entity = null;
    var tank: Entity = null;
    var antenna: Entity = null;
    var cargo_installed: bool = true;
    var tank_installed: bool = true;
    var antenna_installed: bool = true;

    var ring: Entity = null;
    var knob: Entity = null;
    var reset_button: Entity = null;
    var drawing: bool = false;
    var right_touch_camera: bool = false;
    var had_touch: bool = false;
    var anchor: Vec2 = Vec2(0.0, 0.0);

    fn start() {
        this.ring = World.find("Stick ring");
        this.knob = World.find("Stick knob");
        this.reset_button = World.find("Reset crawler");
        this.cargo_button = World.find("Toggle cargo");
        this.tank_button = World.find("Toggle tank");
        this.antenna_button = World.find("Toggle antenna");
        // These independent GLB props ride the moving crawler root.
        // Offsets come from the kit manifest, converted from source Z-up to GLB Y-up.
        // Cargo is stacked above the rear crate; the other two match kit mounts.
        this.cargo = World.find("Crawler side cargo");
        attach_equipment("Crawler side cargo", Vec3(-1.03, 2.21, 2.55));
        this.tank = World.find("Crawler auxiliary tank");
        attach_equipment("Crawler auxiliary tank", Vec3(1.86, 1.13, -0.2));
        this.antenna = World.find("Crawler roof antenna");
        attach_equipment("Crawler roof antenna", Vec3(-1.4, 3.48, -2.9));
        World.set_active(this.ring, false);
        World.set_active(this.knob, false);
    }

    fn attach_equipment(name: String, offset: Vec3) {
        let part = World.find(name);
        if part != null {
            World.set_parent(part, this.entity);
            part.transform.position = offset;
        }
    }

    fn update(dt: f32) {
        // Prototype install/remove: hide the attached model without destroying it.
        // This preserves its parent and local mount for reinstallation.
        if (Input.Keyboard.just_pressed("Digit1") || Ui.is_pressed(this.cargo_button)) {
            this.cargo_installed = !this.cargo_installed;
            if this.cargo != null { World.set_active(this.cargo, this.cargo_installed); }
        }
        if (Input.Keyboard.just_pressed("Digit2") || Ui.is_pressed(this.tank_button)) {
            this.tank_installed = !this.tank_installed;
            if this.tank != null { World.set_active(this.tank, this.tank_installed); }
        }
        if (Input.Keyboard.just_pressed("Digit3") || Ui.is_pressed(this.antenna_button)) {
            this.antenna_installed = !this.antenna_installed;
            if this.antenna != null { World.set_active(this.antenna, this.antenna_installed); }
        }

        // The first right-side finger belongs to the camera, not the stick.
        // Preserve keyboard and left-side floating-stick driving.
        if Input.Touch.count == 0.0 {
            this.had_touch = false;
            this.right_touch_camera = false;
        } else if !this.had_touch {
            this.had_touch = true;
            this.right_touch_camera = Input.Pointer.overlay.x > 0.0 && !Input.Pointer.over_ui;
        }
        let stick_drives = Input.Stick.held && !this.right_touch_camera;
        let keys = Input.Keyboard.axis("ArrowDown", "ArrowUp");
        var throttle = keys;
        if stick_drives && abs(Input.Stick.y) > abs(keys) {
            throttle = -Input.Stick.y;
        }
        let steer_keys = Input.Keyboard.axis("ArrowLeft", "ArrowRight");
        var steering = steer_keys;
        if stick_drives && abs(Input.Stick.x) > abs(steer_keys) {
            steering = Input.Stick.x;
        }
        // Steering reverses with the crawler, like a tracked vehicle.
        if abs(throttle) > 0.01 {
            this.transform.yaw -= steering * turn_speed * dt * sign(throttle);
        }
        this.transform.world_position += this.transform.forward * throttle * speed * dt;

        if Input.Keyboard.just_pressed("Space") || Ui.is_pressed(this.reset_button) {
            this.transform.position = Vec3(0.0, 0.0, 0.0);
            this.transform.yaw = 0.0;
        }

        draw_stick();
    }

    fn draw_stick() {
        if stick_drives && !this.drawing {
            this.drawing = !Input.Pointer.over_ui;
            this.anchor = Input.Pointer.overlay;
        }
        if !stick_drives { this.drawing = false; }
        World.set_active(this.ring, this.drawing);
        World.set_active(this.knob, this.drawing);
        if this.drawing {
            this.ring.transform.position = Vec3(this.anchor.x, this.anchor.y, 0.0);
            let push = Vec2(Input.Stick.x, -Input.Stick.y) * KNOB_TRAVEL;
            this.knob.transform.position = Vec3(this.anchor.x + push.x, this.anchor.y + push.y, 0.0);
        }
    }
}
