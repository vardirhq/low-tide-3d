// The Keeper on foot: a physics character on the imported seabed.
// Keyboard: arrow keys drive the crawler; F leaves or takes the helm. The
// crawler is solid: walk its deck, out the rear doorway and down the ramp. On foot,
// WASD walks relative to the camera, Space jumps and E picks up or installs
// the alternator. Touch: the left thumb's stick drives or walks, and the
// buttons do the same as F, Space and E. Buttons appear only when they apply.
// The engine's 3D character controller clips movement against the seabed and
// salvage colliders; this script owns gravity, jumping and interaction.
const REACH_CRAWLER: f32 = 3.5;
const REACH_HELM: f32 = 1.4;
// Where the Keeper stands to drive, in the crawler's own frame: on the deck
// (1.25 m up) just behind the helm console at the front. The helm is reached
// on foot through the rear doorway and up the ramp.
const HELM_UP: f32 = 1.3;
const HELM_AHEAD: f32 = 0.9;
const REACH_ALTERNATOR: f32 = 1.8;
const REACH_STATION: f32 = 2.2;
const REACH_CARGO: f32 = 1.6;
const REACH_BAY: f32 = 1.3;
// Carrying cargo and wading both slow the Keeper.
const LOADED_PACE: f32 = 0.65;
const WADING_PACE: f32 = 0.55;
const HARD_LANDING: f32 = 0.6;
const JOLT_WEAR: f32 = 20.0;

script Explorer {
    var carrying_alternator: bool = false;
    var repaired: bool = false;
    var aboard: bool = true;
    var fall_speed: f32 = 0.0;
    var airborne: f32 = 0.0;
    var had_touch: bool = false;
    var stick_touch: bool = false;
    @export var walk_speed: f32 = 3.0;
    @export var jump_speed: f32 = 5.0;
    @export var gravity: f32 = 18.0;

    var board_button: Entity = null;
    var jump_button: Entity = null;
    var action_button: Entity = null;
    var objective: Entity = null;
    var crawler_buttons: List<Entity> = [];
    var last_objective: String = "";

    fn start() {
        this.board_button = World.find("Board button");
        this.jump_button = World.find("Jump button");
        this.action_button = World.find("Action button");
        this.objective = World.find("Objective");
        for name in ["Reset crawler", "Toggle cargo", "Toggle tank", "Toggle antenna"] {
            let button = World.find(name);
            if button != null { this.crawler_buttons.push(button); }
        }
    }

    fn update(dt: f32) {
        let crawler = World.find("Astra starter crawler cutaway");
        if crawler == null { return; }
        track_touch();
        let helm = helm_stand(crawler);
        if this.aboard {
            // Driving: the Keeper stands at the helm and turns with the crawler.
            this.transform.world_position = helm;
            this.transform.yaw = crawler.transform.yaw;
            this.fall_speed = 0.0;
            this.airborne = 0.0;
        }
        // Install range is measured on the ground: the tracks keep the Keeper
        // a little way out, and the deck is above the seabed.
        var offset = this.transform.world_position - crawler.transform.world_position;
        offset.y = 0.0;
        let to_crawler = offset.length;
        let at_helm = this.transform.world_position.distance(helm) < REACH_HELM;
        let board = Input.Keyboard.just_pressed("F") || pressed(this.board_button);
        if board && (this.aboard || at_helm) {
            this.aboard = !this.aboard;
            if this.aboard { print("Took the helm. Arrow keys or touch stick to drive."); }
            else { print("Left the helm. WASD to walk, Space to jump, E to interact, F at the helm to drive."); }
            World.send_signal(crawler, "toggle_helm", 1.0);
            let camera = World.find("Overhead perspective camera");
            if camera != null { World.send_signal(camera, "toggle_follow", 1.0); }
        }

        if !this.aboard {
            walk(dt);
            if World.take_signal("take_alternator") > 0.0 {
                this.carrying_alternator = true;
                print("Alternator recovered. Return to the crawler and press E to install.");
            }
        }

        // What E or the action button would do from here, if anything.
        let alternator = World.find("Replacement alternator");
        var near_alternator = false;
        if alternator != null && !this.carrying_alternator && !this.repaired {
            near_alternator = this.transform.world_position.distance(alternator.transform.world_position) <= REACH_ALTERNATOR;
        }
        let can_install = this.carrying_alternator && !this.repaired && to_crawler < REACH_CRAWLER;
        var action = "";
        if !this.aboard {
            if near_alternator { action = "PICK UP"; }
            else if can_install { action = "INSTALL"; }
            else { action = courier_action(crawler); }
        }
        let interact = Input.Keyboard.just_pressed("E") || pressed(this.action_button);
        if interact && action != "" {
            if action == "INSTALL" {
                this.repaired = true;
                this.carrying_alternator = false;
                World.send_signal(crawler, "repair_engine", 1.0);
                Game.set("engine_repaired", 1.0);
                print("Alternator installed.");
            } else if action == "PICK UP" && near_alternator {
                World.send_signal(alternator, "pick_up", 1.0);
            } else if action == "ACCEPT" {
                send_to("Delivery order", "accept");
            } else if action == "PICK UP" || action == "UNLOAD" {
                send_to("Battery pack", "carry");
            } else if action == "LOAD" {
                send_to("Battery pack", "load");
            } else if action == "DELIVER" {
                send_to("Battery pack", "deliver");
            }
        }

        show_controls(at_helm, action);
    }

    // The courier's context action: answer the radio, pick up the cargo, load
    // or unload it at the crawler's cargo bay, or deliver it.
    fn courier_action(crawler: Entity) -> String {
        let order = Game.get("order_state", 0.0);
        let cargo_state = Game.get("cargo_state", 0.0);
        let here = this.transform.world_position;
        if order == 1.0 && near("Last Signal radio", here, REACH_STATION) { return "ACCEPT"; }
        if order != 2.0 { return ""; }
        let bay = cargo_bay(crawler);
        if cargo_state == 0.0 && near("Battery pack", here, REACH_CARGO) { return "PICK UP"; }
        if cargo_state == 1.0 {
            if near("Last Signal beacon", here, REACH_STATION) { return "DELIVER"; }
            if here.distance(bay) < REACH_BAY { return "LOAD"; }
        }
        if cargo_state == 2.0 && here.distance(bay) < REACH_BAY { return "UNLOAD"; }
        return "";
    }

    fn near(name: String, here: Vec3, reach: f32) -> bool {
        let thing = World.find(name);
        if thing == null { return false; }
        var offset = thing.transform.world_position - here;
        offset.y = 0.0;
        return offset.length <= reach;
    }

    fn send_to(name: String, signal: String) {
        let thing = World.find(name);
        if thing != null { World.send_signal(thing, signal, 1.0); }
    }

    // Where cargo rides on the crawler: the rear deck, port side, standing
    // height for the Keeper beside it.
    fn cargo_bay(crawler: Entity) -> Vec3 {
        return crawler.transform.world_position + Vec3(0.0, 1.28, 0.0)
            - crawler.transform.right * 0.7 - crawler.transform.forward * 2.1;
    }

    fn helm_stand(crawler: Entity) -> Vec3 {
        return crawler.transform.world_position + Vec3(0.0, HELM_UP, 0.0) + crawler.transform.forward * HELM_AHEAD;
    }

    fn pressed(button: Entity) -> bool {
        return button != null && Ui.is_pressed(button);
    }

    // A touch that begins on the left half, away from buttons, is the stick;
    // one that begins on the right half belongs to the camera.
    fn track_touch() {
        if Input.Touch.count == 0.0 {
            this.had_touch = false;
            this.stick_touch = false;
        } else if !this.had_touch {
            this.had_touch = true;
            this.stick_touch = Input.Pointer.overlay_x <= 0.0 && !on_button();
        }
    }

    // Buttons, not any interface: the stick's own ring is UI too, and a thumb
    // landing where the stick was last drawn must still be the stick.
    fn on_button() -> bool {
        for button in this.crawler_buttons {
            if World.is_active(button) && Ui.is_hovered(button) { return true; }
        }
        for button in [this.board_button, this.jump_button, this.action_button] {
            if button != null && World.is_active(button) && Ui.is_hovered(button) { return true; }
        }
        return false;
    }

    fn show_controls(at_helm: bool, action: String) {
        for button in this.crawler_buttons { World.set_active(button, this.aboard); }
        if this.board_button != null {
            World.set_active(this.board_button, this.aboard || at_helm);
            if this.aboard { Ui.set_text(this.board_button, "LEAVE HELM"); }
            else { Ui.set_text(this.board_button, "TAKE HELM"); }
        }
        if this.jump_button != null { World.set_active(this.jump_button, !this.aboard); }
        if this.action_button != null {
            World.set_active(this.action_button, action != "");
            if action != "" { Ui.set_text(this.action_button, action); }
        }
        var goal = "";
        if !this.repaired {
            if this.carrying_alternator {
                goal = "Bring the alternator to the crawler";
                if action == "INSTALL" { goal = "Install the alternator"; }
            } else if this.aboard {
                goal = "Engine dead. Leave the helm, find an alternator";
            } else if action == "PICK UP" {
                goal = "Pick up the alternator";
            } else {
                goal = "Find the alternator by the radio station";
            }
        } else {
            goal = courier_goal();
        }
        if this.objective != null && goal != this.last_objective {
            this.last_objective = goal;
            Ui.set_text(this.objective, goal);
        }
    }

    fn courier_goal() -> String {
        let order = Game.get("order_state", 0.0);
        let cargo_state = Game.get("cargo_state", 0.0);
        if order == 1.0 { return "Answer the radio at the signal station"; }
        if order == 3.0 { return "Signal restored. Delivery complete"; }
        if order == 4.0 { return "Route flooded. Wait, then try again"; }
        if order != 2.0 { return "Engine repaired"; }
        if cargo_state == 0.0 { return "Fetch the battery pack from the NW wreck"; }
        if cargo_state == 2.0 { return "Drive it to the beacon, then unload"; }
        return "Deliver the battery pack to the beacon";
    }

    fn walk(dt: f32) {
        // Support can drop out for a step on uneven imported triangles, so a
        // short grace period keeps walking and jumping steady.
        let motion = Physics3d.character_motion(this.entity);
        var supported = false;
        if motion != null { supported = motion.grounded; }
        let carrying = Game.get("cargo_state", 0.0) == 1.0;
        if supported {
            if this.airborne > 0.25 { print("Keeper landed"); }
            if carrying && this.airborne > HARD_LANDING {
                let cargo = World.find("Battery pack");
                if cargo != null { World.send_signal(cargo, "jolt", JOLT_WEAR); }
            }
            this.airborne = 0.0;
        } else {
            this.airborne += dt;
        }
        let grounded = this.airborne < 0.1 && this.fall_speed >= 0.0;

        // Movement is relative to where the camera looks, flattened onto the ground.
        var ahead = Vec3(0.0, 0.0, -1.0);
        let camera = World.find("Overhead perspective camera");
        if camera != null {
            let look = camera.transform.forward;
            if abs(look.x) + abs(look.z) > 0.01 { ahead = Vec3(look.x, 0.0, look.z).normalized; }
        }
        let side = Vec3(-ahead.z, 0.0, ahead.x);
        var forward_input = Input.Keyboard.axis("S", "W");
        var side_input = Input.Keyboard.axis("A", "D");
        if this.stick_touch && Input.Stick.held {
            forward_input = -Input.Stick.y;
            side_input = Input.Stick.x;
        }
        var direction = ahead * forward_input + side * side_input;
        if direction.length > 1.0 { direction = direction.normalized; }
        if direction.length > 0.01 {
            this.transform.yaw = atan2(-direction.x, -direction.z);
        }

        if grounded {
            // No downward push on the ground: the controller's snap keeps the
            // Keeper attached, and pushing down would fight thresholds and slopes.
            this.fall_speed = 0.0;
            if Input.Keyboard.just_pressed("Space") || pressed(this.jump_button) {
                this.fall_speed = -this.jump_speed;
                this.airborne = 0.1;
                print("Keeper jumped");
            }
        } else {
            this.fall_speed += this.gravity * dt;
        }
        var pace = this.walk_speed;
        if carrying { pace *= LOADED_PACE; }
        if this.transform.world_position.y < Game.get("tide_level", -10.0) { pace *= WADING_PACE; }
        let step = direction * pace * dt + Vec3(0.0, -this.fall_speed * dt, 0.0);
        Physics3d.move_character(this.entity, step, grounded && this.fall_speed >= 0.0);

        // Lost below the seabed: put the Keeper back beside the crawler.
        if this.transform.world_position.y < -10.0 {
            let crawler = World.find("Astra starter crawler cutaway");
            this.transform.world_position = helm_stand(crawler);
            this.fall_speed = 0.0;
            this.airborne = 0.0;
            print("Keeper recovered at the helm");
        }
    }
}
