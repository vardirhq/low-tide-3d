// Fixed north-up orthographic camera. Only translate in WORLD space:
// orbit tracking can inherit the crawler's yaw and rotate the whole view.
script CrawlerCamera {
    var following_explorer: bool = false;
    var initialized: bool = false;

    fn update(dt: f32) {
        if World.take_signal("toggle_follow") > 0.0 {
            this.following_explorer = !this.following_explorer;
        }
        var target = World.find("Astra starter crawler cutaway");
        if this.following_explorer { target = World.find("Explorer"); }
        if target == null { return; }
        let focus = target.transform.world_position;
        let desired = Vec3(focus.x, focus.y + 18.0, focus.z);
        if !this.initialized {
            this.transform.world_position = desired;
            this.initialized = true;
        } else {
            let blend = min(1.0, 8.0 * dt);
            this.transform.world_position += (desired - this.transform.world_position) * blend;
        }
    }
}
