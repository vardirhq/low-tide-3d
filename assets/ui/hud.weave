/* Low Tide touch HUD. Presentation only: Decay keeps the button actions. */
.hud-button {
    width: 132px;
    height: 52px;
    background: #17262fe8;
    border-color: #bda47c;
    border-width: 2px;
    border-radius: 12px;
}
#touch-build {
    x: 38vw;
    y: -40vh;
    width: 150px;
    height: 58px;
    background: #36564b;
    border-color: #e2c899;
}
#touch-reset { x: 38vw; y: 40vh; }
#touch-cargo { x: -32vw; y: -40vh; }
#touch-tank { x: -17vw; y: -40vh; }
#touch-antenna { x: -2vw; y: -40vh; }
@media (orientation: portrait) {
    .hud-button { width: 27vw; height: 52px; border-radius: 10px; }
    #touch-build { x: 26vw; y: -42vh; width: 37vw; height: 58px; }
    #touch-reset { x: 26vw; y: 42vh; width: 37vw; height: 54px; }
    #touch-cargo { x: -31vw; y: -33vh; }
    #touch-tank { x: 0vw; y: -33vh; }
    #touch-antenna { x: 31vw; y: -33vh; }
}
@media (max-height: 500px) and (orientation: landscape) {
    .hud-button { width: 110px; height: 44px; }
    #touch-build { x: 38vw; y: -36vh; width: 125px; height: 46px; }
    #touch-reset { x: 38vw; y: 36vh; }
    #touch-cargo { x: -32vw; y: -36vh; }
    #touch-tank { x: -16vw; y: -36vh; }
    #touch-antenna { x: 0vw; y: -36vh; }
}
